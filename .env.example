# Public site origin used for canonical URLs, Open Graph metadata and share links.
# Final public HTTPS domain only. Sharing and canonical/og:url stay disabled while
# this is missing, localhost, a loopback/.local host, or plain http://.
#
# This value is NOT a secret: Next.js inlines NEXT_PUBLIC_* variables into the
# browser bundle at build time. Never put credentials in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SITE_URL=https://invitation.example.com
